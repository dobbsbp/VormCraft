{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VormCraft",
  "version": "0.4.2",
  "identifier": "app.vormcraft.modeler",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5317",
    "beforeDevCommand": "npm run dev -- --port 5317 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5317"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Direct 3D modeler for 3D printing and CAD/CAM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "vorm"
        ],
        "name": "VormCraft model",
        "description": "VormCraft 3D model",
        "role": "Editor",
        "mimeType": "application/x-vormcraft"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBRURCODZDRjYwNTM3MDcKUldRSE53WDJiTGp0ZXQwMW5zZUJqYjlQYWo1YzZUMkdTRGF6RGhYc0dNVzNPUTdkZXhZOFdsVE4K",
      "endpoints": [
        "https://github.com/dobbsbp/VormCraft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
