{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Benup",
  "version": "0.1.0",
  "identifier": "app.benup.modeler",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5317",
    "beforeDevCommand": "npm run dev -- --port 5317 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Benup",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5317"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Direct 3D modeler for 3D printing and CAD/CAM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
